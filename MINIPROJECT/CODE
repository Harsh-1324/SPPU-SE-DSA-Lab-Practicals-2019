/*
MINI PROJECT: Student Management System using Data Structures in Java

Objective:
Design a mini project using different data structures and compare their performance.

Data Structures Used:
1. ArrayList  -> Sequential storage
2. HashMap    -> Fast searching using key-value mapping

Features:
- Add Student
- Display Students
- Search Student
- Delete Student
- Performance Comparison

Concept:
ArrayList searching takes O(n) time
HashMap searching takes O(1) average time

---------------------------------------------------------
HOW TO RUN:
1. Save file as StudentManagementSystem.java
2. Compile:
   javac StudentManagementSystem.java
3. Run:
   java StudentManagementSystem
---------------------------------------------------------
*/

import java.util.*;

class Student {
    int id;
    String name;
    double marks;

    Student(int id, String name, double marks) {
        this.id = id;
        this.name = name;
        this.marks = marks;
    }

    public String toString() {
        return "ID: " + id + " | Name: " + name + " | Marks: " + marks;
    }
}

public class StudentManagementSystem {

    // Data Structures
    static ArrayList<Student> studentList = new ArrayList<>();
    static HashMap<Integer, Student> studentMap = new HashMap<>();

    // Add Student
    static void addStudent(int id, String name, double marks) {
        Student s = new Student(id, name, marks);

        studentList.add(s);
        studentMap.put(id, s);

        System.out.println("Student Added Successfully!");
    }

    // Display Students
    static void displayStudents() {

        if (studentList.isEmpty()) {
            System.out.println("No students found.");
            return;
        }

        System.out.println("\nStudent Records:");
        for (Student s : studentList) {
            System.out.println(s);
        }
    }

    // Search using ArrayList
    static void searchUsingArrayList(int id) {

        long start = System.nanoTime();

        boolean found = false;

        for (Student s : studentList) {
            if (s.id == id) {
                long end = System.nanoTime();

                System.out.println("\nFound using ArrayList:");
                System.out.println(s);

                System.out.println("Search Time: " + (end - start) + " ns");
                found = true;
                break;
            }
        }

        if (!found) {
            System.out.println("Student not found.");
        }
    }

    // Search using HashMap
    static void searchUsingHashMap(int id) {

        long start = System.nanoTime();

        Student s = studentMap.get(id);

        long end = System.nanoTime();

        if (s != null) {
            System.out.println("\nFound using HashMap:");
            System.out.println(s);

            System.out.println("Search Time: " + (end -start) + " ns");
        } else {
            System.out.println("Student not found.");
        }
    }

    // Delete Student
    static void deleteStudent(int id) {

        Student removeStudent = null;

        for (Student s : studentList) {
            if (s.id == id) {
                removeStudent = s;
                break;
            }
        }

        if (removeStudent != null) {
            studentList.remove(removeStudent);
            studentMap.remove(id);

            System.out.println("Student Deleted Successfully!");
        } else {
            System.out.println("Student not found.");
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int choice;

        do {

            System.out.println("\n====== STUDENT MANAGEMENT SYSTEM ======");
            System.out.println("1. Add Student");
            System.out.println("2. Display Students");
            System.out.println("3. Search Student using ArrayList");
            System.out.println("4. Search Student using HashMap");
            System.out.println("5. Delete Student");
            System.out.println("6. Exit");

            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            switch (choice) {

                case 1:

                    System.out.print("Enter Student ID: ");
                    int id = sc.nextInt();

                    sc.nextLine();

                    System.out.print("Enter Student Name: ");
                    String name = sc.nextLine();

                    System.out.print("Enter Student Marks: ");
                    double marks = sc.nextDouble();

                    addStudent(id, name, marks);
                    break;

                case 2:
                    displayStudents();
                    break;

                case 3:

                    System.out.print("Enter ID to Search (ArrayList): ");
                    int searchId1 = sc.nextInt();

                    searchUsingArrayList(searchId1);
                    break;

                case 4:

                    System.out.print("Enter ID to Search (HashMap): ");
                    int searchId2 = sc.nextInt();

                    searchUsingHashMap(searchId2);
                    break;

                case 5:

                    System.out.print("Enter ID to Delete: ");
                    int deleteId = sc.nextInt();

                    deleteStudent(deleteId);
                    break;

                case 6:
                    System.out.println("Exiting Program...");
                    break;

                default:
                    System.out.println("Invalid Choice!");
            }

        } while (choice != 6);

        sc.close();
    }
}
